# GraphQL schema for the jobapps BFF.
#
# Used by the frontend to read, list, and update jobs, and to run scans that look for new
# postings. Subscriptions are served over Server-Sent Events at POST /graphql/stream.

"""Calendar date with no time, formatted YYYY-MM-DD."""
scalar Date

"""Timestamp in RFC 3339 format, e.g. 2026-11-23T14:05:00Z."""
scalar DateTime

enum JobStatus {
  "Found, not yet reviewed."
  NEW
  "Reviewed, plan to apply."
  INTERESTED
  APPLIED
  INTERVIEWING
  OFFER
  "I decided not to pursue it."
  USER_REJECTED
  "The company turned me down."
  COMPANY_REJECTED
  "The posting came down before I applied."
  EXPIRED
}

type Job {
  id: ID!
  companyName: String!
  jobTitle: String!
  "The company's own ID for the posting."
  postingId: String!
  "URL to the posting."
  link: String!
  "Null when the source doesn't say."
  postedDate: Date
  retrievedDate: DateTime!
  status: JobStatus!
  "Set automatically on every update."
  lastUpdated: DateTime!
  notes: String
  "Recruiter or hiring manager. Null until the company makes contact."
  contactName: String
  contactEmail: String
  contactPhone: String
  "As the posting states it, e.g. \"$150k–$190k\". Null if not listed."
  salaryRange: String
  "E.g. \"Remote (US)\" or \"Seattle, WA\". Null if not listed."
  location: String
}

"""One page of jobs."""
type JobPage {
  items: [Job!]!
  "Total number of jobs across all pages."
  totalCount: Int!
}

type Query {
  "A single job by primary key, or null if it doesn't exist."
  job(id: ID!): Job

  "The scan in progress, or null if none is running."
  currentScan: Scan

  """
  Jobs in pages. limit defaults to 50 (max 500); offset defaults to 0.
  With no filter, every job is returned. With no sort, newest retrieved comes first.
  """
  jobs(
    filter: JobFilter
    sort: JobSort = { field: RETRIEVED_DATE, direction: DESC }
    limit: Int = 50
    offset: Int = 0
  ): JobPage!
}

enum JobSortField {
  COMPANY_NAME
  JOB_TITLE
  "Jobs with no posted date sort last in either direction."
  POSTED_DATE
  RETRIEVED_DATE
  "Sorts in workflow order (NEW, INTERESTED, APPLIED, ...), not alphabetically."
  STATUS
  LAST_UPDATED
}

enum SortDirection {
  ASC
  DESC
}

"""
Sort column and direction. Ties are broken by id so paging is stable.
"""
input JobSort {
  field: JobSortField!
  direction: SortDirection! = ASC
}

"""
Narrows the jobs list. Omitted fields don't filter; set fields are combined with AND.
Text matches are case-insensitive substrings.
"""
input JobFilter {
  "Only jobs whose status is one of these. An empty list matches nothing."
  statuses: [JobStatus!]
  "Leave out jobs whose status is one of these, e.g. [USER_REJECTED, COMPANY_REJECTED]."
  excludedStatuses: [JobStatus!]
  companyName: String
  jobTitle: String
}

"""
Fields to change on a job. Omitted fields are left unchanged.
postedDate, notes, salaryRange, location, and the contact fields can be cleared by passing
null explicitly.
id, retrievedDate, and lastUpdated can't be set.
"""
input UpdateJobInput {
  companyName: String
  jobTitle: String
  postingId: String
  link: String
  postedDate: Date
  status: JobStatus
  notes: String
  contactName: String
  contactEmail: String
  contactPhone: String
  salaryRange: String
  location: String
}

type Mutation {
  "Update one job by primary key. Errors if the job doesn't exist."
  updateJob(id: ID!, input: UpdateJobInput!): Job!

  """
  Start scanning every configured company for new postings. Returns right away with the
  plugins that will run; follow progress with the scanUpdated subscription. If a scan is
  already running, returns that scan instead of starting another.
  """
  startScan: Scan!
}

type Subscription {
  """
  The scan's current state immediately, then again every time a plugin starts or finishes.
  Completes after the scan finishes.
  """
  scanUpdated(id: ID!): Scan!
}

enum PluginRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

"""One plugin (one company's job board) within a scan."""
type PluginRun {
  name: String!
  status: PluginRunStatus!
  startedAt: DateTime
  finishedAt: DateTime
  "Postings the plugin returned."
  jobsFound: Int!
  "Postings that weren't already saved."
  jobsAdded: Int!
  "Saved postings marked EXPIRED because the company no longer lists them."
  jobsExpired: Int!
  "What went wrong, when status is FAILED."
  error: String
}

type Scan {
  id: ID!
  startedAt: DateTime!
  "Null while running."
  finishedAt: DateTime
  running: Boolean!
  "In display order. Empty when no plugins are configured."
  plugins: [PluginRun!]!
}
